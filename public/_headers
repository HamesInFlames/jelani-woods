# Cloudflare Pages headers.
# The content Content-Security-Policy (script/style/img/font/connect) is emitted
# as a hash-based <meta> tag by Astro (see astro.config.mjs → experimental.csp).
# The directives below are the ones that only work as real HTTP headers, plus
# transport security and long-lived caching for fingerprinted assets.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin

# Fingerprinted build assets — safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Static media & fonts.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
*.woff2
  Cache-Control: public, max-age=31536000, immutable
