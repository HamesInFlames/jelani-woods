---
/**
 * Editorial photo slot. Renders as a deliberate, grained frame while real
 * photography is dropped in. When `src` is provided it renders that image;
 * otherwise it shows an intentional placeholder with a note about the shot.
 *
 * Drop real images into src/assets and pass an imported asset to `src` to use
 * Astro's optimized <Image>. See README for the asset checklist.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  label?: string;
  ratio?: string; // e.g. "4/5", "16/9", "9/16"
  eyebrow?: string;
  src?: ImageMetadata;
  alt?: string;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  label = 'Photography',
  ratio = '4/5',
  eyebrow,
  src,
  alt,
  class: className = '',
  ...rest
} = Astro.props;

// Map ratios to static Tailwind classes so no inline style attribute is needed
// (keeps the strict CSP working — inline styles can't be CSP-hashed).
// These literal strings must stay here for Tailwind's scanner to emit them.
const ratioClasses: Record<string, string> = {
  '4/5': 'aspect-[4/5]',
  '5/4': 'aspect-[5/4]',
  '4/3': 'aspect-[4/3]',
  '3/4': 'aspect-[3/4]',
  '16/9': 'aspect-[16/9]',
  '9/16': 'aspect-[9/16]',
  '1/1': 'aspect-square',
  auto: 'aspect-auto',
};
const ratioClass = ratioClasses[ratio] ?? 'aspect-[4/5]';
---

<figure
  class:list={['relative overflow-hidden grain-overlay', ratioClass, className]}
  {...rest}
>
  {
    src ? (
      <Image src={src} alt={alt ?? label} class="h-full w-full object-cover" />
    ) : (
      <>
        <div class="frame-grain absolute inset-0" />
        <div class="absolute inset-0 flex flex-col justify-between p-4 sm:p-6">
          <div class="flex items-center justify-between">
            {eyebrow && <span class="eyebrow">{eyebrow}</span>}
            <span class="ml-auto font-sans text-[0.6rem] uppercase tracking-[0.25em] text-bone-mute">
              Image
            </span>
          </div>
          <figcaption class="max-w-[24ch] font-sans text-xs leading-relaxed text-bone-dim">
            {label}
          </figcaption>
        </div>
      </>
    )
  }
  <div
    class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-ink-line"
  >
  </div>
</figure>
