---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>[];
  ogType?: string;
}

const { title, description, schema, ogType } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b0a09" />
    <Seo title={title} description={description} schema={schema} ogType={ogType} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-rust focus:px-4 focus:py-2 focus:font-sans focus:text-sm focus:text-bone"
      >Skip to content</a
    >
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
