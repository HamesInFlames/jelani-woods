---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';

// Above-the-fold latin woff2 subsets, imported as hashed URLs so we can
// preload them from <head>. Preloading fixes late font discovery: without
// it these files aren't known until the (imported) stylesheet is parsed.
// crossorigin is required on font preloads even same-origin, or the browser
// double-fetches. See PLAN.md T2.8.
import antonUrl from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import frauncesUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown>[];
  ogType?: string;
}

const { title, description, schema, ogType } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" href={antonUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={frauncesUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b0a09" />
    <meta name="apple-mobile-web-app-title" content="Jelani Woods" />
    <Seo title={title} description={description} schema={schema} ogType={ogType} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-rust-ui focus:px-4 focus:py-2 focus:font-sans focus:text-sm focus:text-bone"
      >Skip to content</a
    >
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal.ts';
    </script>
  </body>
</html>
