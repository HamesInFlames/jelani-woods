---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | Jelani Woods"
  description="The page you were looking for isn't here."
>
  <section class="flex min-h-[80svh] items-center">
    <div class="shell">
      <p class="eyebrow mb-6">Error 404</p>
      <h1 class="display-hero">Off the<br /><span class="text-rust">rack.</span></h1>
      <p class="lede mt-8 max-w-md">
        That page racked out. Let's get you back to something heavier.
      </p>
      <a
        href="/"
        class="mt-10 inline-flex items-center justify-center bg-rust px-7 py-4 font-sans text-sm font-semibold uppercase tracking-[0.16em] text-bone transition-colors hover:bg-rust-bright"
      >
        Back to home
      </a>
    </div>
  </section>
</Base>
